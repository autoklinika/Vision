{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vision API-01 error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "code"
  ],
  "properties": {
    "schema": {
      "const": "vision.api.error.v1"
    },
    "code": {
      "enum": [
        "BAD_REQUEST",
        "HOST_REJECTED",
        "ORIGIN_REJECTED",
        "NOT_FOUND",
        "METHOD_NOT_ALLOWED",
        "INTERNAL_ERROR"
      ]
    }
  }
}
